generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model StudentRegistration {
  id               Int      @id @default(autoincrement())
  firstName        String
  lastName         String
  email            String   @unique
  phone            String   @unique
  courseCategory   String
  preferredCourses Json
  classType        String
  classMode        String
  preferredTime    String
  goals            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model consulting_payment {
  id                Int      @id @default(autoincrement())
  email             String
  contactEmail      String 
  contactPhone      String   
  courseKey         String                       // "job" | "higher" | "abroad"
  subjects          Json
  meetingMode       String?
  consultDate       DateTime  @db.Date
  slotKey           String?   @unique             // "YYYY-MM-DD" while held/paid, NULL when released
  holdExpiresAt     DateTime?
  amount            Int                          // in paise (199900 = ₹1,999)
  status            String   @default("PENDING") // PENDING | PAID
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email])
  @@index([consultDate])
}